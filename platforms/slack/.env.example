# Claude CLI config directories for each benchmark stack.
# Each points at a separate ~/.claude-* profile that pre-authenticates the
# corresponding MCP server (Slack-MCP, Hintas-MCP, or the analyzer agent).
SLACK_CONFIG_DIR=~/.claude-slack-baseline
HINTAS_CONFIG_DIR=~/.claude-slack-hintas
ANALYSIS_CONFIG_DIR=~/.claude-analyzer

# Slack user tokens for the two benchmarked workspaces.
SLACK_TOKEN=your-token-for-slack-baseline-workspace
HINTAS_TOKEN=your-token-for-slack-hintas-workspace
