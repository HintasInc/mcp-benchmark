# Gmail benchmark — environment template.
#
# Copy to experiments/gmail/.env and fill in the values. See
# experiments/gmail/IMPLEMENTATION.md §2 for OAuth client setup and §4 for
# how refresh tokens are issued.
#
# Each stack has its own Google Cloud OAuth client (Desktop app type) so
# refresh tokens cannot cross-contaminate. The seeder reads
# <STACK>_CLIENT_ID / <STACK>_CLIENT_SECRET / <STACK>_TOKEN (HINTAS_TOKEN is
# the refresh token for the hintas stack — see gmail.toml).

# --- gmail stack (baseline: Gmail MCP - Official) ---
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_TOKEN=

# --- hintas stack (variant: Gmail MCP - Hintas) ---
HINTAS_CLIENT_ID=
HINTAS_CLIENT_SECRET=
HINTAS_TOKEN=
